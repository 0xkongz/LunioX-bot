# ─── Required ────────────────────────────────────────────────────────
# Comma-separated EVM private keys (with 0x prefix). Index 1 = first key, etc.
WALLET_PRIVATE_KEYS=0xkey1,0xkey2,0xkey3

# ─── Optional (defaults shown) ──────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed1.binance.org
CHAIN_ID=56
PORT=3000

# Dashboard auth — REQUIRED to be ≥16 chars in production.
DASHBOARD_API_KEY=changeme

# Default mode every newly-added token starts in. One of:
#   delta_neutral | dca_buy | dca_sell | stopped
DEFAULT_MODE=stopped

DRY_RUN=false
NODE_ENV=production
LOG_LEVEL=info

# ─── PancakeSwap V2 (BSC mainnet) ───────────────────────────────────
# These are PancakeSwap's canonical V2 deployments. Override only if you
# need to point at a fork.
PANCAKE_V2_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
PANCAKE_V2_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73

# ─── Trading defaults ───────────────────────────────────────────────
# These are used as the seed parameters for newly-added tokens. Each
# token can override its own params live from the dashboard.
TRADE_AMOUNT_USD=50
TRADE_INTERVAL_SECONDS=300
VARIANCE_PERCENT=20
DAILY_VOLUME_TARGET_USD=10000
MAX_SLIPPAGE_BPS=100
# On-curve price-impact ceiling (bps). Trades whose constant-product
# impact exceeds this are aborted before the tx is signed. 1000 = 10%.
# Raise this for thin pools (e.g. 2000 = 20%) where you accept the impact.
MAX_PRICE_IMPACT_BPS=1000
DCA_BIAS_PERCENT=70
MAX_GAS_PRICE_GWEI=5
GAS_LIMIT_OVERRIDE=500000

# Default wallet selection for newly-added tokens. Format mirrors the
# original bot: "1-3" (range), "1,3,5" (list), or empty (all wallets).
DEFAULT_TOKEN_WALLETS=

# ─── Persistence (Railway volumes) ──────────────────────────────────
# Path to the JSON file holding the token registry. On Railway, attach a
# persistent volume mounted at /data and use the default below — the
# file survives redeploys.
TOKENS_FILE=/data/tokens.json

# Tracker state directory (per-day daily volume / net-position records).
# Defaults to ./data/tracker locally; on Railway use /data/tracker.
TRACKER_DATA_DIR=/data/tracker

# ─── Security ──────────────────────────────────────────────────────
# Set to "true" ONLY if you need runtime wallet addition via API.
ALLOW_RUNTIME_WALLET_ADDITION=false

# ─── CORS (production only) ─────────────────────────────────────────
# CORS_ORIGIN=https://your-dashboard-domain.com
